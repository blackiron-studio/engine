{
  "name": "Topdown",
  "entry": "src/main.ts",
  "art": "src/art.ts",
  "viewport": {
    "width": 1280,
    "height": 720,
    "scale": "fit"
  },
  "render": {
    "scale": "native",
    "snap": "world"
  },
  "renderer": "auto",
  "fps": true,
  "background": "#0e1410",
  "fonts": [
    "https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@700&family=Instrument+Sans:wght@500;700&display=swap"
  ],
  "post": {
    "bloom": 0.6,
    "bloomThreshold": 0.55,
    "vignette": 0.32,
    "saturation": 1.05,
    "lut": "warm"
  }
}
